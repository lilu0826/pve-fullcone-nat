+/* Copy under the same bucket lock used for deletion: conntracks can be
+ * recycled under RCU. No conntrack pointer escapes this critical section.
+ * A later ordinary SNAT may legally share a translated endpoint. In that
+ * case keep ordinary NAT semantics and decline automatic DNAT altogether.
+ */
+static bool
+nf_nat_fullcone_lookup(struct nf_conn *newct, const struct net_device *in,
+		       struct nf_nat_range2 *range)
 {
-	struct nf_conntrack_tuple reply;
-	unsigned int h;
+	const struct nf_conntrack_tuple *tuple;
+	const struct nf_conntrack_zone *zone = nf_ct_zone(newct);
+	struct nf_conntrack_tuple reply, inside = {};
+	struct net *net = nf_ct_net(newct);
 	const struct nf_conn *ct;
-	int found = 0;
+	unsigned int h;
+	bool found = false, conflict = false;
 
+	tuple = &newct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
 	nf_ct_invert_tuple(&reply, tuple);
 	h = hash_by_src(net, zone, &reply);
-
-	/* Conntracks are SLAB_TYPESAFE_BY_RCU: without the bucket lock an
-	 * entry could be freed and reused while its tuple is copied, and
-	 * the packet sent to some other host.
-	 */
 	spin_lock_bh(&nf_nat_manip_src_locks[h % CONNTRACK_LOCKS]);
 	hlist_for_each_entry(ct, &nf_nat_by_manip_src[h], nat_by_manip_src) {
-		if (same_reply_dst(ct, tuple) &&
-		    net_eq(net, nf_ct_net(ct)) &&
-		    nf_ct_zone_equal(ct, zone, IP_CT_DIR_REPLY)) {
-			/* Copy destination part from original tuple. */
-			nf_ct_invert_tuple(result,
-					   &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple);
-			result->src = tuple->src;
-			/* nf_ct_invert_tuple() set dir to REPLY, but result
-			 * is an original-direction tuple.
-			 */
-			result->dst.dir = IP_CT_DIR_ORIGINAL;
-			found = 1;
-			break;
+		if (!same_reply_dst(ct, tuple) || !net_eq(net, nf_ct_net(ct)) ||
+		    !nf_ct_zone_equal(ct, zone, IP_CT_DIR_REPLY))
+			continue;
+		if (!found) {
+			inside = ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
+			found = true;
+		} else if (!same_src(ct, &inside)) {
+			conflict = true;
 		}
 	}
+	if (!found || conflict)
+		goto out;
+
+	found = false;
+	hlist_for_each_entry(ct, &nf_nat_by_manip_src[h], nat_by_manip_src) {
+		const struct nf_conn_nat *nat = nfct_nat(ct);
+
+		if (!ct->fullcone_masq || !nf_ct_is_confirmed(ct) ||
+		    nf_ct_is_dying(ct) || nf_ct_is_expired(ct) ||
+		    !nat || nat->masq_index != in->ifindex ||
+		    !same_reply_dst(ct, tuple) || !net_eq(net, nf_ct_net(ct)) ||
+		    !nf_ct_zone_equal(ct, zone, IP_CT_DIR_REPLY))
+			continue;
+		range->flags = NF_NAT_RANGE_MAP_IPS | NF_NAT_RANGE_PROTO_SPECIFIED;
+		range->min_addr = range->max_addr = inside.src.u3;
+		range->min_proto = range->max_proto = inside.src.u;
+		found = true;
+		break;
+	}
+out:
 	spin_unlock_bh(&nf_nat_manip_src_locks[h % CONNTRACK_LOCKS]);
+	return found && !conflict;
+}
+
+/* Called only at the final null-binding point, after explicit NAT rules. */
+static unsigned int
+nf_nat_fullcone_inbound(struct nf_conn *ct, struct sk_buff *skb,
+			const struct nf_hook_state *state)
+{
+	struct nf_nat_range2 range = {};
+	struct nf_conn_nat *nat;
+	struct sock *sk;
+	unsigned int ret;
+
+	if (!IS_ENABLED(CONFIG_NF_NAT_FULLCONE_MASQUERADE) ||
+	    state->pf != NFPROTO_IPV4 || state->hook != NF_INET_PRE_ROUTING ||
+	    !state->in || nf_ct_is_confirmed(ct) ||
+	    nf_ct_zone(ct)->dir != NF_CT_DEFAULT_ZONE_DIR ||
+	    (nf_ct_protonum(ct) != IPPROTO_TCP && nf_ct_protonum(ct) != IPPROTO_UDP))
+		return NF_ACCEPT;
+	/* Do not redirect ports currently owned by the router, including
+	 * high ports. New local listeners take precedence on subsequent flows.
+	 */
+	if (inet_addr_type_dev_table(state->net, state->in, ip_hdr(skb)->daddr) != RTN_LOCAL)
+		return NF_ACCEPT;
+	sk = nf_sk_lookup_slow_v4(state->net, skb, state->in);
+	if (sk) {
+		sock_gen_put(sk);
+		return NF_ACCEPT;
+	}
+	if (!nf_nat_fullcone_lookup(ct, state->in, &range))
+		return NF_ACCEPT;
+	nat = nf_ct_nat_ext_add(ct);
+	if (!nat)
+		return NF_DROP;
+	ret = nf_nat_setup_info(ct, &range, NF_NAT_MANIP_DST);
+	if (ret == NF_ACCEPT) {
+		ct->fullcone_inbound = true;
+		nat->masq_index = state->in->ifindex;
+	}
+	return ret;
+}
+
+/* The endpoint setup lock serializes new fullcone flows. The bysource
+ * bucket lock additionally protects against concurrent object destruction.
+ * Reuse precedes random port selection, including fully-random rules.
+ */
+static int
+nf_nat_fullcone_reuse(struct nf_conn *newct,
+		      const struct nf_conntrack_tuple *orig,
+		      struct nf_conntrack_tuple *result,
+		      const struct nf_nat_range2 *range)
+{
+	struct net *net = nf_ct_net(newct);
+	const struct nf_conntrack_zone *zone = nf_ct_zone(newct);
+	const struct nf_conn_nat *nat = nfct_nat(newct);
+	unsigned int h = hash_by_src(net, zone, orig);
+	const struct nf_conn *ct;
+	int found = 0;
+
+	spin_lock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
+	hlist_for_each_entry(ct, &nf_nat_bysource[h], nat_bysource) {
+		const struct nf_conn_nat *other_nat = nfct_nat(ct);
+
+		if (!ct->fullcone_masq || nf_ct_is_dying(ct) ||
+		    !nat || !other_nat || nat->masq_index != other_nat->masq_index ||
+		    !same_src(ct, orig) || !net_eq(net, nf_ct_net(ct)) ||
+		    !nf_ct_zone_equal(ct, zone, IP_CT_DIR_ORIGINAL))
+			continue;
+		nf_ct_invert_tuple(result, &ct->tuplehash[IP_CT_DIR_REPLY].tuple);
+		result->dst = orig->dst;
+		if (!nf_inet_addr_cmp(&result->src.u3, &range->min_addr))
+			continue;
+		/* An incompatible later port range must not silently split EIM. */
+		found = nf_in_range(result, range) ? 1 : -1;
+		break;
+	}
+	spin_unlock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
 	return found;
 }
 
